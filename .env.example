# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose to the browser. Used for the public booking page.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public URL of the app (booking links, emails, auth redirects). Production: https://adina.pro
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: transactional email (booking confirmations + owner notifications) via https://resend.com
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Reservas <reservas@adina.pro>"
EMAIL_FROM=
